---
import * as icons from 'lucide-static';

interface Props {
  name: keyof typeof icons;
  size?: number;
  class?: string;
}
const { name, size = 22, class: cls = '' } = Astro.props;
const svg = String(icons[name])
  .replace(/width="24"/, `width="${size}"`)
  .replace(/height="24"/, `height="${size}"`)
  .replace('<svg', `<svg aria-hidden="true" focusable="false" data-icon="${String(name)}"`)
  .replace(/class="[^"]*"/, `class="icon ${cls}"`);
---

<Fragment set:html={svg} />
