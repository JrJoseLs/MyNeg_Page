---
import { SITE, waLink } from '../config';
import Icon from './Icon.astro';
---

<section class="section" id="ecf" data-scene="opacity:0.1" aria-labelledby="ecf-title">
  <div class="wrap">
    <div class="panel" data-reveal>
      <div class="glow"></div>
      <span class="eyebrow">Facturación electrónica · Ley 32-23</span>
      <h2 class="h2" id="ecf-title">
        El e-CF ya viene.
        <br />
        <span class="grad">Tú ya estás listo.</span>
      </h2>
      <p class="lead">
        Desde el <strong>15 de noviembre de 2026</strong> los contribuyentes pequeños y micro deben emitir comprobantes
        fiscales electrónicos. MyNeg ya emite E31, E32 y E34, imprime el QR de la DGII y maneja la contingencia por ti.
      </p>

      <div class="countdown" id="countdown" data-deadline={`${SITE.ecfDeadline}T00:00:00-04:00`} aria-live="off">
        <div>
          <strong data-u="d">--</strong>
          <span>días</span>
        </div>
        <div>
          <strong data-u="h">--</strong>
          <span>horas</span>
        </div>
        <div>
          <strong data-u="m">--</strong>
          <span>minutos</span>
        </div>
        <div>
          <strong data-u="s">--</strong>
          <span>segundos</span>
        </div>
      </div>
      <p class="after" id="countdown-after" hidden>
        El e-CF ya es obligatorio. Con MyNeg emites desde el primer día.
      </p>

      <div class="chips">
        <span>E31 Crédito fiscal</span>
        <span>E32 Consumo</span>
        <span>E34 Nota de crédito</span>
        <span>QR DGII</span>
        <span>Contingencia automática</span>
        <span>Compras desde XML</span>
      </div>
      <a
        class="btn btn-primary"
        href={waLink('Hola, quiero estar listo para el e-CF con MyNeg.')}
        target="_blank"
        rel="noopener"
      >
        <Icon name="MessageCircle" /> Quiero estar listo
      </a>
    </div>
  </div>
</section>

<script>
  const el = document.getElementById('countdown')!;
  const deadline = new Date(el.dataset.deadline!).getTime();
  const units = Object.fromEntries([...el.querySelectorAll<HTMLElement>('[data-u]')].map((n) => [n.dataset.u!, n]));
  const pad = (n: number) => String(n).padStart(2, '0');
  const tick = () => {
    const ms = deadline - Date.now();
    if (ms <= 0) {
      el.hidden = true;
      document.getElementById('countdown-after')!.hidden = false;
      return;
    }
    const s = Math.floor(ms / 1000);
    units.d.textContent = String(Math.floor(s / 86400));
    units.h.textContent = pad(Math.floor((s % 86400) / 3600));
    units.m.textContent = pad(Math.floor((s % 3600) / 60));
    units.s.textContent = pad(s % 60);
    setTimeout(tick, 1000);
  };
  tick();
</script>

<style>
  .panel {
    position: relative;
    overflow: hidden;
    border-radius: 32px;
    padding: clamp(32px, 6vw, 80px);
    background: linear-gradient(160deg, rgba(255, 176, 32, 0.08), rgba(41, 151, 255, 0.06) 50%, rgba(5, 7, 13, 0.6));
    box-shadow: inset 0 0 0 1px rgba(255, 176, 32, 0.2);
    text-align: center;
  }
  .panel .eyebrow {
    color: var(--mango);
  }
  .panel .lead {
    margin-inline: auto;
  }
  .glow {
    position: absolute;
    width: 600px;
    height: 600px;
    left: 50%;
    top: -340px;
    margin-left: -300px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(255, 176, 32, 0.25), transparent 65%);
    pointer-events: none;
  }
  .countdown {
    display: flex;
    justify-content: center;
    gap: clamp(10px, 2vw, 20px);
    margin: 44px 0 10px;
  }
  .countdown div {
    min-width: clamp(70px, 14vw, 132px);
    padding: 18px 10px 14px;
    border-radius: 20px;
    background: rgba(5, 7, 13, 0.55);
    box-shadow: inset 0 0 0 1px var(--line-2);
  }
  .countdown strong {
    display: block;
    font-family: var(--display);
    font-size: clamp(34px, 6vw, 68px);
    line-height: 1;
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.03em;
  }
  .countdown span {
    font-size: 12.5px;
    color: var(--text-3);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }
  .after {
    margin-top: 30px;
    font-size: 20px;
    color: var(--mango);
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px;
    margin: 30px 0 34px;
  }
  .chips span {
    font-family: var(--mono);
    font-size: 12.5px;
    padding: 7px 12px;
    border-radius: 10px;
    background: var(--card-2);
    box-shadow: inset 0 0 0 1px var(--line);
  }
</style>
