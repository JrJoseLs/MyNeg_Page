---
import { waLink } from '../config';
import Icon from './Icon.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<header class="nav" id="nav">
  <div class="nav-inner">
    <a class="brand" href={`${base}/`} aria-label="MyNeg, inicio">
      <img src={`${base}/favicon.svg`} alt="" width="30" height="30" />
      <span>MyNeg</span>
    </a>
    <nav aria-label="Principal">
      <ul>
        <li>
          <a href="#como-funciona">Cómo funciona</a>
        </li>
        <li>
          <a href="#ecf">e-CF</a>
        </li>
        <li>
          <a href="#roles">Roles</a>
        </li>
        <li>
          <a href="#precios">Precios</a>
        </li>
        <li>
          <a href="#preguntas">Preguntas</a>
        </li>
      </ul>
    </nav>
    <a
      class="btn btn-primary nav-cta"
      href={waLink('Hola, quiero una demo de MyNeg para mi negocio.')}
      target="_blank"
      rel="noopener"
    >
      <Icon name="MessageCircle" size={18} /> <span>Pedir demo</span>
    </a>
  </div>
</header>

<style>
  .nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
    padding: 14px var(--gutter);
    transition: transform 0.4s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .nav.hidden {
    transform: translateY(-110%);
  }
  .nav-inner {
    max-width: var(--max);
    margin: 0 auto;
    display: flex;
    align-items: center;
    gap: 24px;
    height: 60px;
    padding: 0 10px 0 18px;
    border-radius: 999px;
    background: rgba(10, 14, 24, 0.55);
    backdrop-filter: blur(18px) saturate(1.4);
    -webkit-backdrop-filter: blur(18px) saturate(1.4);
    box-shadow:
      inset 0 0 0 1px var(--line),
      0 20px 60px -30px rgba(0, 0, 0, 0.8);
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: var(--display);
    font-weight: 700;
    font-size: 20px;
    text-decoration: none;
    letter-spacing: -0.02em;
  }
  nav {
    margin-left: auto;
  }
  ul {
    display: flex;
    gap: 4px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  ul a {
    display: block;
    padding: 8px 14px;
    border-radius: 999px;
    font-size: 14.5px;
    color: var(--text-2);
    text-decoration: none;
    transition:
      color 0.2s,
      background 0.2s;
  }
  ul a:hover {
    color: var(--text);
    background: var(--card-2);
  }
  .nav-cta {
    --h: 44px;
    padding: 0 18px;
    font-size: 15px;
  }
  @media (max-width: 860px) {
    nav {
      display: none;
    }
    .nav-cta {
      margin-left: auto;
    }
  }
  @media (max-width: 380px) {
    .nav-cta span {
      display: none;
    }
  }
</style>
